{
	// Paths and the `$app` types come from SvelteKit: `svelte-kit sync`
	// (part of `pnpm check`) writes what this extends.
	"extends": "$app/tsconfig",
	"include": ["src", "*"],
	"compilerOptions": {
		"strict": true,
		// format.ts imports seed.ts by its real name, so test/seed.test.ts can run both in Node.
		"allowImportingTsExtensions": true
	}
}
