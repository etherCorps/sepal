{
  "name": "sepal",
  "version": "0.2.0-alpha.0",
  "description": "Native Svelte apps, drawn by Blitz: a Svelte custom renderer for the Blitz HTML/CSS engine, its Vite preset and the sepal command",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/etherCorps/sepal.git",
    "directory": "packages/sepal"
  },
  "homepage": "https://github.com/etherCorps/sepal#readme",
  "bugs": "https://github.com/etherCorps/sepal/issues",
  "engines": {
    "node": ">=22"
  },
  "keywords": [
    "svelte",
    "blitz",
    "desktop",
    "native",
    "renderer",
    "gui",
    "vite",
    "vite-plugin",
    "svelte-blitz"
  ],
  "type": "module",
  "bin": {
    "sepal": "./cli.js"
  },
  "exports": {
    ".": {
      "types": "./types/index.d.ts",
      "default": "./src/index.js"
    },
    "./renderer": {
      "types": "./types/renderer.d.ts",
      "default": "./src/renderer.js"
    },
    "./protocol": {
      "types": "./types/protocol.d.ts",
      "default": "./src/protocol.js"
    },
    "./updater": {
      "types": "./types/updater.d.ts",
      "default": "./src/updater.js"
    },
    "./fs": {
      "types": "./types/fs.d.ts",
      "default": "./src/fs.js"
    },
    "./dialog": {
      "types": "./types/dialog.d.ts",
      "default": "./src/dialog.js"
    },
    "./clipboard": {
      "types": "./types/clipboard.d.ts",
      "default": "./src/clipboard.js"
    },
    "./shell": {
      "types": "./types/shell.d.ts",
      "default": "./src/shell.js"
    },
    "./window": {
      "types": "./types/window.d.ts",
      "default": "./src/window.js"
    },
    "./dom": {
      "types": "./types/dom.d.ts",
      "default": "./src/dom.js"
    },
    "./vite": {
      "types": "./types/vite/vite.d.ts",
      "default": "./vite/vite.js"
    },
    "./sveltekit": {
      "types": "./types/vite/sveltekit.d.ts",
      "default": "./vite/sveltekit.js"
    }
  },
  "files": [
    "src",
    "vite",
    "types",
    "cli.js"
  ],
  "scripts": {
    "check": "tsc && tsc -p tsconfig.node.json",
    "prepare": "tsc && tsc -p tsconfig.node.json"
  },
  "dependencies": {
    "@ethercorps/calyx": "workspace:*"
  },
  "peerDependencies": {
    "svelte": "^5.59.0",
    "@sveltejs/vite-plugin-svelte": ">=7",
    "vite": ">=8",
    "@sveltejs/kit": ">=3.4 <3.5"
  },
  "peerDependenciesMeta": {
    "@sveltejs/kit": {
      "optional": true
    }
  },
  "devDependencies": {
    "@sveltejs/kit": "^3.4.0",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@types/node": "^26.6.6",
    "svelte": "^5.59.1",
    "typescript": "^6.0.3",
    "vite": "^8.3.8"
  }
}
