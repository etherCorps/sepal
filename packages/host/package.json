{
  "name": "@ethercorps/calyx",
  "version": "0.2.0-alpha.0",
  "description": "Calyx, the Sepal host: finds the binary for this machine, which comes in a package of its own",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/etherCorps/sepal.git",
    "directory": "packages/host"
  },
  "homepage": "https://github.com/etherCorps/sepal#readme",
  "bugs": "https://github.com/etherCorps/sepal/issues",
  "engines": {
    "node": ">=22"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./types/index.d.ts",
      "default": "./index.js"
    }
  },
  "files": [
    "index.js",
    "types"
  ],
  "optionalDependencies": {
    "@ethercorps/calyx-darwin-arm64": "workspace:*",
    "@ethercorps/calyx-darwin-x64": "workspace:*",
    "@ethercorps/calyx-linux-x64-gnu": "workspace:*",
    "@ethercorps/calyx-linux-arm64-gnu": "workspace:*"
  },
  "scripts": {
    "check": "tsc",
    "prepare": "tsc"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "typescript": "^6.0.3"
  }
}
