{
	"compilerOptions": {
		"allowJs": true,
		"checkJs": true,
		"strict": true,
		"declaration": true,
		"emitDeclarationOnly": true,
		"rootDir": ".",
		"outDir": "types",
		"target": "es2022",
		"module": "esnext",
		"moduleResolution": "bundler",
		"lib": ["es2023"],
		"types": ["node"],
		"skipLibCheck": true
	},
	"include": ["index.js"]
}
