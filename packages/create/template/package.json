{
	"name": "svelte-blitz-app",
	"private": true,
	"version": "0.1.0",
	"type": "module",
	"scripts": {
		"dev": "vite build --watch",
		"build": "vite build",
		"start": "vite build && svelte-blitz run",
		"bundle": "vite build && svelte-blitz bundle",
		"check": "svelte-check --tsconfig ./tsconfig.json"
	},
	"dependencies": {
		"@ethercorps/svelte-blitz": "^0.1.0",
		"svelte": "^5.59.1"
	},
	"devDependencies": {
		"@ethercorps/svelte-blitz-cli": "^0.1.0",
		"@ethercorps/svelte-blitz-vite": "^0.1.0",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@tailwindcss/vite": "^4.3.5",
		"svelte-check": "^4.7.8",
		"tailwindcss": "^4.3.5",
		"typescript": "^6.0.3",
		"vite": "^8.3.8"
	}
}
