{
	"name": "sepal-app",
	"private": true,
	"version": "0.1.0",
	"type": "module",
	"imports": {
		"#lib": "./src/lib/index.ts",
		"#lib/*": "./src/lib/*"
	},
	"scripts": {
		"dev": "vite build --watch",
		"build": "vite build",
		"start": "vite build && sepal run",
		"bundle": "vite build && sepal bundle",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json"
	},
	"dependencies": {
		"sepal": "^0.1.0",
		"svelte": "^5.59.1"
	},
	"devDependencies": {
		"@sveltejs/kit": "~3.4.0",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@tailwindcss/vite": "^4.3.5",
		"svelte-check": "^4.7.8",
		"tailwindcss": "^4.3.5",
		"typescript": "^6.0.3",
		"vite": "^8.3.8"
	}
}
