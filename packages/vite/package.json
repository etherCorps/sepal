{
  "name": "@ethercorps/svelte-blitz-vite",
  "version": "0.1.0",
  "description": "Vite preset and file-based router for svelte-blitz apps",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/etherCorps/svelte-blitz.git",
    "directory": "packages/vite"
  },
  "homepage": "https://github.com/etherCorps/svelte-blitz#readme",
  "bugs": "https://github.com/etherCorps/svelte-blitz/issues",
  "engines": {
    "node": ">=22"
  },
  "keywords": [
    "svelte",
    "blitz",
    "vite",
    "vite-plugin",
    "router",
    "desktop"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./types/vite.d.ts",
      "default": "./src/vite.js"
    },
    "./router": {
      "types": "./types/router.d.ts",
      "default": "./src/router.js"
    },
    "./navigation": {
      "types": "./types/navigation.d.ts",
      "default": "./src/navigation.js"
    },
    "./state": {
      "types": "./types/state.d.ts",
      "default": "./src/state.js"
    },
    "./ambient": {
      "types": "./ambient.d.ts"
    }
  },
  "files": [
    "src",
    "types",
    "ambient.d.ts"
  ],
  "scripts": {
    "check": "tsc && tsc -p tsconfig.node.json",
    "prepare": "tsc && tsc -p tsconfig.node.json"
  },
  "dependencies": {
    "@ethercorps/svelte-blitz-host": "workspace:*"
  },
  "peerDependencies": {
    "@ethercorps/svelte-blitz": "workspace:^",
    "@sveltejs/vite-plugin-svelte": ">=7",
    "svelte": "^5.59.0",
    "vite": ">=8"
  },
  "devDependencies": {
    "@ethercorps/svelte-blitz": "workspace:*",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@types/node": "^26.6.6",
    "svelte": "^5.59.1",
    "typescript": "^6.0.3",
    "vite": "^8.3.8"
  }
}
